# Required: create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Optional OpenRouter configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=TunaRAG LangChain Example

# Models available through OpenRouter
TUNARAG_CHAT_MODEL=openai/gpt-4.1-mini
TUNARAG_EMBEDDING_MODEL=openai/text-embedding-3-small
